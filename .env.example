APP_NAME="Exposição Cenpaleo"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=America/Sao_Paulo
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR

# CREDENCIAIS DO ADMINISTRADOR
ADMIN_USERNAME=admin
ADMIN_PASSWORD=cenpaleo2026

# CONFIGURAÇÃO DE BANCO DE DADOS (SQLite Padrão Local)
DB_CONNECTION=sqlite

# DRIVERS DE SESSÃO E CACHE
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file

# ENVIO DE E-MAIL (MAIL_MAILER=log grava envios em storage/logs/laravel.log)
MAIL_MAILER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="visitas@cenpaleo.org.br"
MAIL_FROM_NAME="Exposição Cenpaleo"

# SUPORTE OPCIONAL A SUPABASE / POSTGRESQL EM PRODUÇÃO
# DB_CONNECTION=pgsql
# DB_HOST=db.xxx.supabase.co
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=postgres
# DB_PASSWORD=sua_senha
